# Copy this file to .env and fill in your values
# Never commit .env to version control

# Gmail SMTP (activate with: SPRING_PROFILES_ACTIVE=docker,gmail)
# Create App Password at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# TextBelt SMS (free dummy SMS — no account needed)
# textbelt_test  → always succeeds, no real SMS sent (dev/CI default)
# textbelt       → 1 free real SMS per day per IP
# <your-key>     → paid key for higher quota (https://textbelt.com)
TEXTBELT_API_KEY=textbelt_test

# SMS provider: 'console' (default, local log) or 'textbelt'
SMS_PROVIDER=console
